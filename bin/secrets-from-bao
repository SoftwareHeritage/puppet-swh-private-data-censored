#!/bin/bash

bao kv scan secrets-puppet | tail -n +3 | grep -v tmp/ | tr '/' ' ' | while read dir value; do
    if [ $dir = 'common' ]; then filename=$dir.yaml; else filename=hostname/$dir.yaml; fi
    if ! [ -z $value ] && ! grep -q "^${value}:" $filename; then
        echo $value: $value >>$filename
    fi
done
